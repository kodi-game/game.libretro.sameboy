msgid "Input"
msgstr "Ввод"

msgctxt "#30131"
msgid "Configure input parameters: rumble support."
msgstr "Настройка параметров ввода: поддержка вибрации."

msgctxt "#30132"
msgid "Defines which type of content should trigger rumble effects."
msgstr "Определяет, какой тип содержимого должен вызывать эффекты вибрации."

msgctxt "#30133"
msgid "Only for rumble-enabled games"
msgstr "Только для игр с поддержкой вибрации"

msgctxt "#30134"
