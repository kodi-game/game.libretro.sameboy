msgctxt "#30061"
msgid "Defines which type of color correction should be applied when playing Game Boy Color games."
msgstr "Určuje typ korekce barev používaný při hraní her pro Game Boy Color."

msgctxt "#30062"
msgid "Modern – Balanced"
msgstr "Moderní – vyvážená"

msgctxt "#30063"
