msgctxt "#30093"
msgid "Selects the color palette that should be used when playing Game Boy games on Game Boy #1."
msgstr "Určuje barevnou paletu používanou při hraní her pro Game Boy na Game Boy #1."

msgctxt "#30094"
msgid "Selects the color palette that should be used when playing Game Boy games on Game Boy #2."
msgstr "Určuje barevnou paletu používanou při hraní her pro Game Boy na Game Boy #2."

msgctxt "#30095"
msgid "Defines which type of color correction should be applied when playing Game Boy Color games on Game Boy #1."
msgstr "Určuje typ korekce barev používaný při hraní her pro Game Boy Color na Game Boy #1."

msgctxt "#30096"
